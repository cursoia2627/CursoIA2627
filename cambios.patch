diff -ruN -x node_modules -x .env -x package-lock.json -x package.json proyecto_orig/frontend/src/components/Pedidos.js proyecto/frontend/src/components/Pedidos.js
--- a/frontend/src/components/Pedidos.js	1970-01-01 01:00:00.000000000 +0100
+++ b/frontend/src/components/Pedidos.js	2026-11-26 10:41:55.965321768 +0100
@@ -0,0 +1,216 @@
+import React, { useCallback, useEffect, useState } from "react";
+import { ShoppingCart, RefreshCw, XCircle } from "lucide-react";
+import { articulosApi, pedidosApi } from "../api/client";
+import "./pedidos.css";
+
+const SIGUIENTES = {
+  pendiente: ["preparando", "cancelado"],
+  preparando: ["enviado", "cancelado"],
+  enviado: ["entregado"],
+  entregado: [],
+  cancelado: [],
+};
+const euros = (n) =>
+  Number(n).toLocaleString("es-ES", { style: "currency", currency: "EUR" });
+const fecha = (v) => {
+  const d = new Date(typeof v === "string" && !v.includes("T") ? v.replace(" ", "T") : v);
+  return Number.isNaN(d.getTime()) ? "—" : d.toLocaleDateString("es-ES");
+};
+
+export default function Pedidos({ isAdmin = false }) {
+  const [articulos, setArticulos] = useState([]);
+  const [pedidos, setPedidos] = useState([]);
+  const [cantidades, setCantidades] = useState({});
+  const [cargando, setCargando] = useState(true);
+  const [enviando, setEnviando] = useState(false);
+  const [error, setError] = useState("");
+  const [aviso, setAviso] = useState("");
+
+  const cargar = useCallback(async () => {
+    setError("");
+    try {
+      const [arts, peds] = await Promise.all([
+        isAdmin ? Promise.resolve([]) : articulosApi.listar(),
+        pedidosApi.listar(50, 0),
+      ]);
+      setArticulos(arts);
+      setPedidos(peds.items || []);
+    } catch (e) {
+      setError(e.message);
+    } finally {
+      setCargando(false);
+    }
+  }, [isAdmin]);
+
+  useEffect(() => {
+    cargar();
+  }, [cargar]);
+
+  const lineas = Object.entries(cantidades)
+    .map(([id, cantidad]) => ({ id_articulo: Number(id), cantidad: Number(cantidad) }))
+    .filter((l) => l.cantidad > 0);
+  const total = lineas.reduce((s, l) => {
+    const a = articulos.find((x) => x.id_articulo === l.id_articulo);
+    return s + (a ? a.precio * l.cantidad : 0);
+  }, 0);
+
+  async function realizarPedido() {
+    setEnviando(true);
+    setError("");
+    setAviso("");
+    try {
+      const p = await pedidosApi.crear(lineas);
+      setAviso(`Pedido ${p.id_pedido} realizado por ${euros(p.total)}.`);
+      setCantidades({});
+      await cargar();
+    } catch (e) {
+      setError(e.message);
+    } finally {
+      setEnviando(false);
+    }
+  }
+
+  async function accion(promesa) {
+    setError("");
+    setAviso("");
+    try {
+      await promesa;
+      await cargar();
+    } catch (e) {
+      setError(e.message);
+    }
+  }
+
+  if (cargando) return <p>Cargando…</p>;
+
+  return (
+    <section className="panel pedidos-panel">
+      <div className="panel-heading">
+        <div className="heading-title">
+          <ShoppingCart className="heading-icon" size={30} />
+          <div>
+            <h2>{isAdmin ? "Pedidos de los clientes" : "Pedidos"}</h2>
+            <p>
+              {isAdmin
+                ? "Cambia el estado de los pedidos. Los clientes lo verán y el asistente también."
+                : "Elige artículos y haz tu pedido. El asistente conoce tus pedidos."}
+            </p>
+          </div>
+        </div>
+        <button type="button" className="action-button" onClick={cargar}>
+          <RefreshCw size={16} /> Actualizar
+        </button>
+      </div>
+
+      {error && <p role="alert" className="pedidos-error">{error}</p>}
+      {aviso && <p role="status" className="pedidos-ok">{aviso}</p>}
+
+      {!isAdmin && (
+        <>
+          <h3>Catálogo</h3>
+          <div className="pedidos-catalogo">
+            {articulos.map((a) => (
+              <article key={a.id_articulo} className="pedidos-articulo">
+                <div>
+                  <strong>{a.nombre}</strong>
+                  <span className="pedidos-categoria">{a.categoria}</span>
+                  <p>{a.descripcion}</p>
+                </div>
+                <div className="pedidos-compra">
+                  <b>{euros(a.precio)}</b>
+                  {a.disponible ? (
+                    <label>
+                      Cantidad
+                      <input
+                        type="number"
+                        min="0"
+                        max={Math.min(10, a.stock)}
+                        value={cantidades[a.id_articulo] ?? 0}
+                        onChange={(e) =>
+                          setCantidades({
+                            ...cantidades,
+                            [a.id_articulo]: Math.max(0, Math.min(10, Number(e.target.value) || 0)),
+                          })
+                        }
+                      />
+                    </label>
+                  ) : (
+                    <span className="pedidos-agotado">Agotado</span>
+                  )}
+                </div>
+              </article>
+            ))}
+          </div>
+          <div className="pedidos-resumen">
+            <span>
+              {lineas.length
+                ? `${lineas.reduce((s, l) => s + l.cantidad, 0)} unidades · ${euros(total)}`
+                : "Aún no has elegido artículos"}
+            </span>
+            <button
+              type="button"
+              className="action-button"
+              disabled={!lineas.length || enviando}
+              onClick={realizarPedido}
+            >
+              <ShoppingCart size={16} /> {enviando ? "Enviando…" : "Realizar pedido"}
+            </button>
+          </div>
+        </>
+      )}
+
+      <h3>{isAdmin ? "Todos los pedidos" : "Mis pedidos"}</h3>
+      {pedidos.length === 0 ? (
+        <p>No hay pedidos todavía.</p>
+      ) : (
+        <div className="pedidos-lista">
+          {pedidos.map((p) => (
+            <article key={p.id_pedido} className="pedidos-pedido">
+              <div>
+                <strong>Pedido {p.id_pedido}</strong> · {fecha(p.fecha_pedido)}
+                {isAdmin && <> · {p.nombre} {p.apellido}</>}
+                <ul>
+                  {p.lineas.map((l) => (
+                    <li key={l.id_articulo}>
+                      {l.cantidad} × {l.nombre}
+                    </li>
+                  ))}
+                </ul>
+              </div>
+              <div className="pedidos-lateral">
+                <b>{euros(p.total)}</b>
+                <span className={"pedidos-estado estado-" + p.estado}>{p.estado}</span>
+                {isAdmin && SIGUIENTES[p.estado].length > 0 && (
+                  <select
+                    aria-label={`Cambiar estado del pedido ${p.id_pedido}`}
+                    value=""
+                    onChange={(e) =>
+                      e.target.value &&
+                      accion(pedidosApi.cambiarEstado(p.id_pedido, e.target.value))
+                    }
+                  >
+                    <option value="">Cambiar estado…</option>
+                    {SIGUIENTES[p.estado].map((s) => (
+                      <option key={s} value={s}>
+                        {s}
+                      </option>
+                    ))}
+                  </select>
+                )}
+                {!isAdmin && p.estado === "pendiente" && (
+                  <button
+                    type="button"
+                    className="pedidos-cancelar"
+                    onClick={() => accion(pedidosApi.cancelar(p.id_pedido))}
+                  >
+                    <XCircle size={15} /> Cancelar
+                  </button>
+                )}
+              </div>
+            </article>
+          ))}
+        </div>
+      )}
+    </section>
+  );
+}
diff -ruN -x node_modules -x .env -x package-lock.json -x package.json proyecto_orig/frontend/src/components/pedidos.css proyecto/frontend/src/components/pedidos.css
--- a/frontend/src/components/pedidos.css	1970-01-01 01:00:00.000000000 +0100
+++ b/frontend/src/components/pedidos.css	2026-11-26 10:41:55.967287571 +0100
@@ -0,0 +1,23 @@
+.site.pedidos-theme { --accent: #8a5cf6; --tint: #f1ebff; --soft: #dccdff; }
+.tab-pedidos { background: #f1ebff; color: #4c2f9a; }
+.tab-pedidos.active { background: #8a5cf6; color: #fff; }
+.pedidos-catalogo { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; margin-bottom: 14px; }
+.pedidos-articulo, .pedidos-pedido { border: 1px solid #e5e7eb; border-radius: 14px; padding: 14px; display: flex; justify-content: space-between; gap: 12px; }
+.pedidos-articulo p { margin: 6px 0 0; font-size: 13px; color: #687080; }
+.pedidos-categoria { margin-left: 8px; font-size: 12px; color: #8a5cf6; }
+.pedidos-compra, .pedidos-lateral { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; flex-shrink: 0; }
+.pedidos-compra input { width: 64px; margin-left: 6px; }
+.pedidos-agotado { color: #b42318; font-size: 13px; }
+.pedidos-resumen { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 24px; }
+.pedidos-lista { display: grid; gap: 10px; }
+.pedidos-pedido ul { margin: 6px 0 0; padding-left: 18px; font-size: 13px; }
+.pedidos-estado { border-radius: 999px; padding: 2px 10px; font-size: 12px; background: #eef0f5; }
+.estado-pendiente { background: #fff3c7; }
+.estado-preparando { background: #e0ecff; }
+.estado-enviado { background: #e5f4e4; }
+.estado-entregado { background: #d6e7cd; }
+.estado-cancelado { background: #fbebeb; }
+.pedidos-cancelar { border: 0; background: transparent; color: #b42318; display: inline-flex; gap: 4px; align-items: center; cursor: pointer; }
+.pedidos-error { color: #b42318; }
+.pedidos-ok { color: #1b6b2f; }
+.dark .pedidos-articulo, .dark .pedidos-pedido { border-color: #384056; }
